[Unit]
Description=SubBridge subscription converter for 3x-ui
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=subbridge
Group=subbridge
ExecStart=/usr/local/lib/subbridge/subbridge-core -config /etc/subbridge/config.json -management-config /etc/subbridge/management.json
EnvironmentFile=-/etc/subbridge/panel.env
StateDirectory=subbridge
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
MemoryMax=4G
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
Environment=GOMEMLIMIT=256MiB
Environment=GOMAXPROCS=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/subbridge
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
